{
  "entities": {
    "userProfile": {
      "title": "UserProfile",
      "description": "User profile with gamification and aesthetic preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "avatar": { "type": "string", "maxLength": 10 },
        "title": { "type": "string", "maxLength": 100 },
        "level": { "type": "string", "maxLength": 50 },
        "theme": { "type": "string", "maxLength": 50 },
        "xp": { "type": "number" },
        "stardust": { "type": "number" },
        "currentStreak": { "type": "number" },
        "bestStreak": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "xp", "stardust", "level", "theme"]
    },
    "savedFlashcard": {
      "title": "SavedFlashcard",
      "description": "Flashcard saved in student celestial grimoire",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "front": { "type": "string", "maxLength": 500 },
        "back": { "type": "string", "maxLength": 1000 },
        "topic": { "type": "string", "maxLength": 100 },
        "mnemonic": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "front", "back", "topic"]
    },
    "savedSolution": {
      "title": "SavedSolution",
      "description": "Archived AI study solution with step-by-step breakdown",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "question": { "type": "string", "maxLength": 1000 },
        "topic": { "type": "string", "maxLength": 100 },
        "level": { "type": "string", "maxLength": 50 },
        "dreamySummary": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "question", "topic"]
    },
    "celestialNote": {
      "title": "CelestialNote",
      "description": "Note held in TechTut and synced with Google Keep",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 5000 },
        "topic": { "type": "string", "maxLength": 100 },
        "color": { "type": "string", "maxLength": 50 },
        "isPinned": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/userProfile" },
      "description": "Root user profile document"
    },
    "/users/{userId}/flashcards/{flashcardId}": {
      "schema": { "$ref": "#/entities/savedFlashcard" },
      "description": "Sub-collection of user saved study flashcards"
    },
    "/users/{userId}/solutions/{solutionId}": {
      "schema": { "$ref": "#/entities/savedSolution" },
      "description": "Sub-collection of user archived study solutions"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/celestialNote" },
      "description": "Sub-collection of user study notes"
    }
  }
}
